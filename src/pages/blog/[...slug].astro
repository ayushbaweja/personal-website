---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostSubtitle } from '../../utils/blog';

export async function getStaticPaths() {
    const posts = await getCollection(
        'blog',
        ({ data }) => import.meta.env.DEV || !data.draft,
    );
    return posts.map(post => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

interface Props {
    post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const subtitle = getPostSubtitle(post);
const readingMinutes = Math.max(1, Math.ceil(post.body.trim().split(/\s+/).length / 220));
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
---

<BaseLayout pageTitle={`${post.data.title} — Ayush Baweja`} description={subtitle} slowAutomata={true}>
    <main class="page-shell">
        <nav class="page-nav" aria-label="Breadcrumb">
            <a href="/">Ayush Baweja</a>
            <span aria-hidden="true">/</span>
            <a href="/blog/">Writing</a>
        </nav>

        <article class="content-card blog-post">
            <header class="post-header">
                <h1>{post.data.title}</h1>
                {subtitle && <p class="post-subtitle">{subtitle}</p>}
                <div class="post-meta">
                    <time datetime={post.data.published.toISOString()}>
                        {formatDate(post.data.published)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{readingMinutes} min read</span>
                </div>
            </header>

            <div class="article-content">
                <Content />
            </div>

            <footer class="post-footer">
                <a href="/blog/">&larr; All writing</a>
            </footer>
        </article>
    </main>
</BaseLayout>
