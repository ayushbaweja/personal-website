---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchPapers } from '../utils/fetch-papers.mjs';

const pageTitle = "Papers — Ayush Baweja";
const papers = await fetchPapers();

function formatAuthors(authors: string[]): string {
    if (authors.length === 0) return '';
    if (authors.length <= 3) return authors.join(', ');
    return authors.slice(0, 3).join(', ') + ' et al.';
}
---

<BaseLayout pageTitle={pageTitle}>
    <main class="scroll-container">
        <section class="full-section" style="border-top: none;">
            <div class="section-content">
                <h1>Papers</h1>
                {papers.length > 0 ? (
                    <ul class="papers-list">
                        {papers.map(paper => (
                            <li>
                                <a href={paper.url}>{paper.title}</a>
                                <span class="paper-meta">
                                    {formatAuthors(paper.authors)}
                                    {paper.year && ` (${paper.year})`}
                                    {paper.venue && ` — ${paper.venue}`}
                                </span>
                                {paper.tags.length > 0 && (
                                    <span class="paper-tags">
                                        {paper.tags.map(t => <span class="tag">{t}</span>)}
                                    </span>
                                )}
                                <span class="paper-date">Added {paper.dateStr}</span>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <p class="empty-note">No papers yet — check back soon.</p>
                )}
                <p><a href="/">&larr; Back home</a></p>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .papers-list {
        list-style: none;
        padding-left: 0;
    }
    .papers-list li {
        margin-bottom: 1rem;
    }
    .papers-list a {
        font-size: 1.15rem;
    }
    .paper-meta {
        display: block;
        font-size: 0.85rem;
        color: #666;
        margin-top: 0.15rem;
    }
    .paper-tags {
        display: inline-block;
        margin-top: 0.25rem;
    }
    .paper-date {
        display: block;
        font-size: 0.8rem;
        color: #999;
        margin-top: 0.15rem;
    }
    .empty-note {
        color: #666;
        font-style: italic;
    }
</style>
