---
// Singleton preview popup component - rendered once in BaseLayout
---

<div id="hover-preview" class="hover-preview" role="tooltip" aria-hidden="true">
    <img class="hover-preview__thumbnail" src="" alt="" />
    <h4 class="hover-preview__title"></h4>
    <p class="hover-preview__description"></p>
    <div class="hover-preview__domain">
        <img class="hover-preview__favicon" src="" alt="" />
        <span class="hover-preview__url"></span>
    </div>
</div>

<style>
    .hover-preview {
        position: fixed;
        z-index: 9999;
        max-width: 320px;
        min-width: 200px;
        background: var(--background-color, #fffff8);
        border: 1px solid var(--border-color, #e8e8e8);
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
        padding: 1rem;
        pointer-events: none;

        /* Animation */
        opacity: 0;
        transform: translateY(8px) scale(0.96);
        transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                    transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hover-preview.visible {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    .hover-preview__thumbnail {
        width: 100%;
        height: 120px;
        object-fit: cover;
        border-radius: 4px;
        margin-bottom: 0.75rem;
        display: none;
    }

    .hover-preview__thumbnail.has-image {
        display: block;
    }

    .hover-preview__title {
        font-family: 'et-book', serif;
        font-size: 1rem;
        font-weight: normal;
        margin: 0 0 0.5rem 0;
        line-height: 1.3;
        color: var(--text-color, #111111);
    }

    .hover-preview__description {
        font-size: 0.875rem;
        color: var(--accent-color, #333333);
        margin: 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .hover-preview__domain {
        font-size: 0.75rem;
        color: var(--link-color, #0066cc);
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .hover-preview__favicon {
        width: 14px;
        height: 14px;
        display: none;
    }

    .hover-preview__favicon.has-image {
        display: block;
    }

    /* Loading skeleton */
    .hover-preview.loading .hover-preview__title,
    .hover-preview.loading .hover-preview__description {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 4px;
        color: transparent;
        min-height: 1em;
    }

    .hover-preview.loading .hover-preview__title {
        width: 80%;
    }

    .hover-preview.loading .hover-preview__description {
        width: 100%;
        min-height: 3em;
    }

    @keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* Hide on touch devices */
    @media (hover: none) {
        .hover-preview {
            display: none !important;
        }
    }

    /* Internal section preview style */
    .hover-preview.internal .hover-preview__domain {
        display: none;
    }
</style>
