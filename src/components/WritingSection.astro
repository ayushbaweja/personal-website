---
import { getCollection } from 'astro:content';
import { getPostSubtitle } from '../utils/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
---

<h2>Writing</h2>
<ul class="writing-list">
    {posts.map(post => (
        <li>
            <a
                href={`/blog/${post.slug}/`}
                data-preview-title={post.data.title}
                data-preview-description={getPostSubtitle(post)}
            >{post.data.title}</a>
            <span class="post-date">{formatDate(post.data.published)}</span>
        </li>
    ))}
</ul>
<p class="writing-more"><a href="/blog/" data-no-preview>All writing &rarr;</a></p>

<style>
    .writing-list {
        list-style: none;
        padding-left: 0;
    }
    .writing-list li {
        margin-bottom: 1rem;
    }
    .writing-list a {
        font-size: 1.15rem;
    }
    .post-date {
        display: block;
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 0.15rem;
    }
    .writing-more {
        margin: 0.9rem 0 0;
        font-size: 0.9rem;
    }
</style>
